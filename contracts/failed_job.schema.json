{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FailedJob (DynamoDB rs-<stage>-failed-jobs, PK failed_id; GSI job_id-created_at)",
  "type": "object",
  "required": ["failed_id", "job_id", "stage", "s3_key", "error_type", "error_message", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "failed_id": {"type": "string"},
    "job_id": {"type": "string"},
    "stage": {"type": "string", "enum": ["JD_PARSE", "TEXT_EXTRACT", "COMPREHEND", "PARSE", "SCORE", "UNKNOWN"]},
    "s3_key": {"type": "string"},
    "error_type": {"type": "string", "enum": ["UNSUPPORTED_TYPE", "CORRUPT_FILE", "EMPTY_TEXT", "JD_NO_SKILLS", "TRANSIENT_EXHAUSTED", "UNKNOWN"]},
    "error_message": {"type": "string", "maxLength": 1000},
    "attempts": {"type": "integer", "minimum": 0},
    "message_id": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["OPEN", "RETRIED", "RESOLVED"]},
    "created_at": {"type": "string"}
  }
}
